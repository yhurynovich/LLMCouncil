# ===========================================
# LLM Council Configuration
# ===========================================

# Required – get your key at https://openrouter.ai
OPENROUTER_API_KEY=

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins for CORS
# Default: http://localhost:5173,http://localhost:3000,http://192.168.31.66:5173,http://192.168.31.66:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.31.66:5173,http://192.168.31.66:5174

# ===========================================
# SSRF Protection Configuration
# ===========================================
# Comma-separated list of IPs allowed to bypass SSRF protection
# Used when making requests to local/internal services
# Default: 192.168.31.66
SSRF_ALLOWED_IPS=192.168.31.66

# ===========================================
# Proxy Configuration (optional)
# ===========================================
# HTTP/HTTPS proxy for outbound requests
# HTTPS_PROXY=
# HTTP_PROXY=

# ===========================================
# Logging
# ===========================================
# LOG_LEVEL=info
