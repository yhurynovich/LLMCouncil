# ===========================================
# Login & password
# ===========================================
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme

# Frontend credentials (VITE_ prefix makes them available in browser bundle)
VITE_AUTH_USERNAME=admin
VITE_AUTH_PASSWORD=changeme

# ===========================================
# LLM Council Configuration
# ===========================================

# Required – get your key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# Backend port
VITE_BACKEND_PORT=5174

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins for CORS
# Default: http://localhost:5173,http://localhost:3000,http://192.168.31.66:5173,http://192.168.31.66:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.31.66:5173,http://192.168.31.66:5174

# ===========================================
# SSRF Protection & Auth Bypass Configuration
# ===========================================
# Comma-separated list of CIDR subnets that:
# 1. Bypass inbound authentication (no login required)
# 2. Bypass outbound SSRF protection (allowed to make requests to local services)
# Default: 192.168.31.0/24,127.0.0.1/32
AUTH_BYPASS_SUBNET=192.168.31.0/24,127.0.0.1/32

# ===========================================
# Proxy Configuration (optional)
# ===========================================
# HTTP/HTTPS proxy for outbound requests
# HTTPS_PROXY=
# HTTP_PROXY=

# ===========================================
# Docker Configuration
# ===========================================
# UID/GID for the backend container user (match host user to avoid permission issues with mounted volumes)
# Run `id -u` and `id -g` on host to get values
UID=1000
GID=1000

# ===========================================
# Logging
# ===========================================
# LOG_LEVEL=info

# ===========================================
# Models without function calling support
# ===========================================
# Comma-separated list of model IDs that don't support tools/function calling
# These models will have web search disabled (no tools sent)
# Default: (empty - most models support tools)
MODELS_NO_TOOLS=

# ===========================================
# MCP File Access — Hybrid Embed + MCP
# ===========================================
# When enabled, large files are made available to LLMs via on-demand file tools
# (read_file, search_files, list_files, get_file_info) instead of being embedded
# directly in prompts. Small files are still embedded directly for immediate access.
# MCP_FILE_ACCESS_ENABLED=true

# File size thresholds for hybrid embed vs MCP decision
# IMAGE_MAX_BASE64_MB=2          # Max base64 image size after downscaling
# TEXT_EMBED_MAX_KB=100          # Text files at or below this size are embedded directly
# TEXT_EMBED_MAX_MB=1            # Text files at or below this size are embedded with truncation
# IMAGE_MAX_DIMENSION=1920       # Max pixel dimension for downscaled images

# Upload limits (per file and total warning)
MAX_TEXT_SIZE_MB=100
MAX_IMAGE_SIZE_MB=100
MAX_UPLOAD_TOTAL_MB=500

