# ── Backend ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim

# Install uv (fast Python package manager used by this project)
RUN pip install --no-cache-dir uv

# Install beautifulsoup4 for DuckDuckGo HTML scraping
RUN pip install --no-cache-dir beautifulsoup4 httpx

# Create non-root user with fixed UID/GID to avoid permission issues with mounted volumes
ARG UID=1000
ARG GID=1000
RUN (getent group ${GID} || groupadd -g ${GID} appuser) && \
    useradd -u ${UID} -g ${GID} -m -s /bin/bash appuser

WORKDIR /app

# Ensure /app is owned by appuser before any operations
RUN chown -R ${UID}:${GID} /app

# Copy dependency files with correct ownership
COPY --chown=${UID}:${GID} pyproject.toml uv.lock ./

# Install project deps + beautifulsoup4 into the uv venv as appuser
USER appuser
RUN uv sync --no-dev --frozen && uv pip install beautifulsoup4

# Copy the rest of the source with correct ownership
COPY --chown=${UID}:${GID} backend/ ./backend/
COPY --chown=${UID}:${GID} main.py ./
COPY --chown=${UID}:${GID} docker-entrypoint.sh ./
RUN chmod +x ./docker-entrypoint.sh

# Ensure the data directory exists
RUN mkdir -p /app/data/conversations /app/data/uploads

EXPOSE 8001 8002

CMD ["./docker-entrypoint.sh"]
