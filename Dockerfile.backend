# ── Backend ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim

# Install uv (fast Python package manager used by this project)
RUN pip install --no-cache-dir uv

# Install beautifulsoup4 for DuckDuckGo HTML scraping
RUN pip install --no-cache-dir beautifulsoup4 httpx

# Create non-root user with fixed UID/GID to avoid permission issues with mounted volumes
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} appuser && \
    useradd -u ${UID} -g ${GID} -m -s /bin/bash appuser

WORKDIR /app

# Copy dependency files first for better layer caching
COPY pyproject.toml uv.lock ./

# Install project deps + beautifulsoup4 into the uv venv
RUN uv sync --no-dev --frozen && uv pip install beautifulsoup4

# Copy the rest of the source
COPY backend/ ./backend/
COPY main.py ./

# Ensure the data directory exists and set ownership
RUN mkdir -p /app/data/conversations /app/data/uploads && \
    chown -R ${UID}:${GID} /app/data

# Switch to non-root user
USER appuser

EXPOSE 8001

CMD ["uv", "run", "python", "-m", "backend.main"]
